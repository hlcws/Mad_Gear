---
import { site } from '../site.config.mjs';
import { ago } from '../lib/status.js';

interface Props { feed: any }
const { feed } = Astro.props;
const tw = feed.twitch;
const yt = feed.youtube;
const host = new URL(site.url).hostname;
const twitchEmbed =
  `https://player.twitch.tv/?channel=${site.feeds.twitchLogin}&parent=${host}&parent=www.${host}&parent=localhost&muted=true`;
const twitchDuration = (d: string) => d?.replace(/(\d+)h(\d+)m\d+s/, '$1:$2 h').replace(/^(\d+)m\d+s$/, '$1 min');
const hasVideos = tw?.videos?.length || yt?.videos?.length;
const anyLive = tw?.live || yt?.live;
---
<section id="streams">
  <div class="wrap">
    <span class="kutte-label">Auf Sendung</span>
    <h2>Streams <span class="accent">&</span> Videos</h2>
    <p class="lead">Turniere, Money Matches und Casuals aus dem Clubhaus, live auf Twitch und YouTube und zum Nachschauen.</p>

    {tw?.live && (
      <>
        <div class="subhead">
          <h3><span class="pill pill-live"><span class="dot"></span>Live</span> {tw.stream.title}</h3>
          <a class="btn btn-twitch btn-sm" href={site.links.twitch}>Auf Twitch öffnen</a>
        </div>
        <iframe class="player" src={twitchEmbed} allowfullscreen title="Twitch Livestream" loading="lazy"></iframe>
      </>
    )}

    {!tw?.live && yt?.live && (
      <>
        <div class="subhead">
          <h3><span class="pill pill-live"><span class="dot"></span>Live</span> {yt.live.title}</h3>
          <a class="btn btn-primary btn-sm" href={yt.live.url}>Auf YouTube öffnen</a>
        </div>
        <iframe class="player" src={`https://www.youtube-nocookie.com/embed/${yt.live.id}?mute=1`} allowfullscreen title="YouTube Livestream" loading="lazy"></iframe>
      </>
    )}

    {tw?.videos?.length > 0 && (
      <>
        <div class="subhead">
          <h3>Letzte Streams</h3>
          <a class="btn btn-sm" href={`${site.links.twitch}/videos`}>Alle auf Twitch</a>
        </div>
        <div class="media-grid">
          {tw.videos.slice(0, 4).map((v: any) => (
            <a class="video" href={v.url}>
              <div class="thumb" style={v.thumbnail ? `background-image:url('${v.thumbnail}')` : undefined}>
                {v.duration && <span class="badge">{twitchDuration(v.duration)}</span>}
              </div>
              <div class="body">
                <p class="title">{v.title}</p>
                <p class="meta">{ago(v.publishedAt)} · {v.views} Aufrufe</p>
              </div>
            </a>
          ))}
        </div>
      </>
    )}

    {yt?.videos?.length > 0 && (
      <>
        <div class="subhead">
          <h3>Letzte Streams auf YouTube</h3>
          {site.links.youtube && <a class="btn btn-sm" href={`${site.links.youtube}/streams`}>Alle Streams</a>}
        </div>
        <div class="media-grid">
          {yt.videos.slice(0, 4).map((v: any) => (
            <a class="video" href={v.url}>
              <div class="thumb" style={`background-image:url('${v.thumbnail}')`}></div>
              <div class="body">
                <p class="title">{v.title}</p>
                <p class="meta">{ago(v.publishedAt)}{v.views ? ` · ${v.views} Aufrufe` : ''}</p>
              </div>
            </a>
          ))}
        </div>
      </>
    )}

    {!hasVideos && !anyLive && (
      <div class="channel-cards">
        <div class="channel-card">
          <h3>Twitch</h3>
          <p>Wir streamen Turniere und High-Stakes Sets direkt aus dem Clubhaus. Folgen, um nichts zu verpassen.</p>
          <a class="btn btn-twitch" href={site.links.twitch}>twitch.tv/{site.feeds.twitchLogin}</a>
        </div>
        <div class="channel-card">
          <h3>Discord</h3>
          <p>Hier wird angekündigt, wer wann da ist, und es werden Matches ausgemacht.</p>
          <a class="btn btn-discord" href={site.links.discord}>Discord beitreten</a>
        </div>
      </div>
    )}
  </div>
</section>
