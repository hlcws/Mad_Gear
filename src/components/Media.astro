---
import { site } from '../site.config.mjs';
import { ago } from '../lib/status.js';
import SectionHead from './SectionHead.astro';
import { renderLive } from '../lib/render.js';

interface Props { feed: any; head: { label?: string; title?: string } }
const { feed, head } = Astro.props;
const cutoff = Date.now() - site.maxVideoAgeDays * 864e5;
const recent = (vids: any[] = []) => vids.filter((v) => new Date(v.publishedAt).getTime() > cutoff);
const tw = feed.twitch && { ...feed.twitch, videos: recent(feed.twitch.videos) };
const yt = feed.youtube && { ...feed.youtube, videos: recent(feed.youtube.videos) };
const twitchDuration = (d: string) => d?.replace(/(\d+)h(\d+)m\d+s/, '$1:$2 h').replace(/^(\d+)m\d+s$/, '$1 min');
const hasVideos = tw?.videos?.length || yt?.videos?.length;
const anyLive = tw?.live || yt?.live;
---
<section id="streams">
  <div class="wrap">
    <SectionHead fm={head} />
    <div class="lead md"><slot /></div>

    <div data-live="stream" set:html={renderLive(feed)} />

    {tw?.videos?.length > 0 && (
      <>
        <div class="subhead">
          <h3>Letzte Streams auf Twitch</h3>
          <a class="btn btn-sm" href={`${site.links.twitch}/videos`}>Alle auf Twitch</a>
        </div>
        <div class="media-grid">
          {tw.videos.slice(0, 4).map((v: any) => (
            <a class="video" href={v.url}>
              <div class="thumb" style={v.thumbnail ? `background-image:url('${v.thumbnail}')` : undefined}>
                {v.duration && <span class="badge">{twitchDuration(v.duration)}</span>}
              </div>
              <div class="body">
                <p class="title">{v.title}</p>
                <p class="meta">{ago(v.publishedAt)} · {v.views} Aufrufe</p>
              </div>
            </a>
          ))}
        </div>
      </>
    )}

    {yt?.videos?.length > 0 && (
      <>
        <div class="subhead">
          <h3>Letzte Streams auf YouTube</h3>
          {site.links.youtube && <a class="btn btn-sm" href={`${site.links.youtube}/streams`}>Alle auf YouTube</a>}
        </div>
        <div class="media-grid">
          {yt.videos.slice(0, 4).map((v: any) => (
            <a class="video" href={v.url}>
              <div class="thumb" style={`background-image:url('${v.thumbnail}')`}></div>
              <div class="body">
                <p class="title">{v.title}</p>
                <p class="meta">{ago(v.publishedAt)}{v.views ? ` · ${v.views} Aufrufe` : ''}</p>
              </div>
            </a>
          ))}
        </div>
      </>
    )}

    {!hasVideos && !anyLive && (
      <div class="channel-cards">
        <div class="channel-card">
          <h3>Twitch</h3>
          <p>Wir streamen Turniere und High-Stakes Sets direkt aus dem Club. Folgen, um nichts zu verpassen.</p>
          <a class="btn btn-twitch" href={site.links.twitch}>twitch.tv/{site.feeds.twitchLogin}</a>
        </div>
        <div class="channel-card">
          <h3>Discord</h3>
          <p>Hier wird angekündigt, wer wann da ist, und es werden Matches ausgemacht.</p>
          <a class="btn btn-discord" href={site.links.discord}>Discord beitreten</a>
        </div>
      </div>
    )}
  </div>
</section>
