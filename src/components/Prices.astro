---
import * as preise from '../content/preise.md';
interface Props { donations?: boolean }
const { donations = true } = Astro.props;
---
<div class="prices">
  {preise.frontmatter.prices.filter((p) => donations || !p.donation).map((p) => (
    <div class="price">
      <div class="tier">{p.tier} {p.icon}</div>
      <div class="amount">{p.price}€</div>
      <div class="dur">{p.duration}</div>
      <div class="note">{p.note}</div>
    </div>
  ))}
</div>
