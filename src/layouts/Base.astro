---
import { logo } from '../lib/assets.js';
import { site } from '../site.config.mjs';
import '../styles/global.css';

interface Props { title?: string; description?: string; }
const { title, description = `${site.name} – ${site.tagline}. ${site.usualSchedule}.` } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} – Fighting Game Locals Frankfurt / Rhein-Main`;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const textLogo = logo('logo-text');
const markLogo = logo('logo-mark');
const ogImage = logo('logo-full') ?? markLogo ?? '/photos/location1.jpg';

const nav = [
  ['/termine.html', 'Termine'],
  ['/anfahrt.html', 'Clubhaus'],
  ['/tickets.html', 'Tickets'],
  ['/regeln.html', 'Clubregeln'],
  ['/gang.html', 'Die Gang'],
  [site.links.shop, 'Merch'],
];
const current = (href: string) => (href.replace('.html', '') === path ? 'page' : undefined);
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(ogImage, site.url)} />
  <meta name="theme-color" content="#0b0b0d" />
  {markLogo?.endsWith('.svg') && <link rel="icon" type="image/svg+xml" href={markLogo} />}
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="/">
        {textLogo
          ? <img src={textLogo} alt="Mad Gear" height="36" />
          : <span>Mad<b>Gear</b>FFM</span>}
        <small>{site.kanji}</small>
      </a>
      <nav class="nav" aria-label="Hauptmenü">
        {nav.map(([href, label]) => <a href={href} aria-current={current(href)}>{label}</a>)}
      </nav>
      <a class="btn btn-discord btn-sm header-cta" href={site.links.discord}>Discord</a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="mobile-nav">Menü</button>
    </div>
    <nav id="mobile-nav" class="mobile-nav" aria-label="Menü">
      {nav.map(([href, label]) => <a href={href} aria-current={current(href)}>{label}</a>)}
    </nav>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <div>
        <strong>{site.name}</strong> · {site.address.street}, {site.address.city}<br />
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </div>
      <nav aria-label="Footer">
        <a href={site.links.discord}>Discord</a>
        <a href={site.links.twitch}>Twitch</a>
        {site.links.youtube && <a href={site.links.youtube}>YouTube</a>}
        <a href={site.links.twitter}>Twitter</a>
        <a href={site.links.shop}>Merch-Shop</a>
        <a href={site.links.hardedge}>HardEdge</a>
        <a href="/impressum.html">Impressum & Datenschutz</a>
        <a href="/agb.html">AGB</a>
      </nav>
    </div>
  </footer>

  <script>
    const btn = document.querySelector('.menu-toggle');
    const menu = document.getElementById('mobile-nav');
    btn?.addEventListener('click', () => {
      const open = menu!.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
    });
  </script>
</body>
</html>
