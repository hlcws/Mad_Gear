---
// Layout only. Members and text live in src/content/gang.md
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import { site } from '../site.config.mjs';
import * as gang from '../content/gang.md';
const members = gang.frontmatter.members ?? [];
---
<Base title="Die Gang" description={`Die Ringleader von ${site.name}.`}>
  <section>
    <div class="wrap">
      <SectionHead fm={gang.frontmatter} />
      <div class="lead md"><gang.Content /></div>
      <div class="team" style="margin-top:28px">
        {members.map((m) => (
          <div class="member">
            <img src={`/photos/${m.photo || 'default.jpg'}`} alt={m.nick} loading="lazy" />
            <div class="body">
              <div class="role">{m.role}</div>
              <p class="nick">{m.nick}</p>
              <div>{m.name}{m.handle ? ` · ${m.handle}` : ''}</div>
              <p class="games">{m.games}</p>
              {m.links?.map((l) => <a href={l.url}>{l.label}</a>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
