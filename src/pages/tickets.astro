---
import Base from '../layouts/Base.astro';
import Prices from '../components/Prices.astro';
import { inline } from '../lib/inline.js';
import * as tickets from '../content/tickets.md';
// Text lives in src/content/tickets.md, prices in src/content/preise.md.
// The PayPal options below must match the hosted PayPal button.
const subscriptionPlan = 'P-04C428923N755423BMLUOVNI';
---
<Base title="Tickets">
  <div class="wrap">
    <article class="prose">
      <span class="kutte-label">Eintritt</span>
      <h1>{tickets.frontmatter.title}</h1>
      {tickets.frontmatter.callout && <div class="callout" set:html={inline(tickets.frontmatter.callout)} />}
      <Prices />
      <tickets.Content />

      <hr />
      <label class="accept">
        <input type="checkbox" id="accept" />
        <span>Ich akzeptiere die o.g. Bestimmungen, <a href="/agb.html">AGB</a> und <a href="/regeln.html">Clubregeln</a>.</span>
      </label>

      <div id="checkout" hidden>
        <h2>Ticket kaufen</h2>
        <form action="https://www.paypal.com/cgi-bin/webscr" method="post" target="_top">
          <input type="hidden" name="cmd" value="_s-xclick" />
          <input type="hidden" name="hosted_button_id" value="WCHKEZZZB2BJL" />
          <input type="hidden" name="on0" value="Dauer" />
          <input type="hidden" name="on1" value="Nickname" />
          <input type="hidden" name="currency_code" value="EUR" />
          <p><label>Ticket<br />
            <select name="os0" class="field">
              <option value="Tourist (1 Tag)">Tourist (1 Tag) – 10,00 €</option>
              <option value="Goon (Wochenende)">Goon (Wochenende) – 15,00 €</option>
              <option value="Supergoon (Monat)">Supergoon (Monat) – 25,00 €</option>
              <option value="Spender">Spender – 5,00 €</option>
            </select></label></p>
          <p><label>Nickname<br /><input type="text" name="os1" maxlength="200" class="field" /></label></p>
          <button class="btn btn-primary" type="submit">Weiter zu PayPal</button>
        </form>
        <p style="margin-top:16px">Alternativ direkt an: MadGearFFM@gmail.com · Betreff: Nickname + Datum</p>

        <h2>Supergoon-Abo</h2>
        <div id="paypal-subscribe"></div>
      </div>
    </article>
  </div>

  <style>
    .accept { display: flex; gap: 10px; align-items: flex-start; cursor: pointer; }
    .accept input { margin-top: 6px; }
    .field { width: 100%; max-width: 360px; padding: 10px 12px; border-radius: 10px; border: 1px solid var(--border); background: var(--surface-2); color: var(--text); font: inherit; }
    #paypal-subscribe { max-width: 360px; background: #fff; border-radius: 12px; padding: 12px; }
    #paypal-subscribe:empty { display: none; }
  </style>

  <script is:inline define:vars={{ plan: subscriptionPlan }}>
    const box = document.getElementById('accept');
    const checkout = document.getElementById('checkout');
    let sdkLoaded = false;
    box.addEventListener('change', () => {
      checkout.hidden = !box.checked;
      if (!box.checked || sdkLoaded) return;
      sdkLoaded = true;
      const s = document.createElement('script');
      s.src = 'https://www.paypal.com/sdk/js?client-id=AYgAZUl1zBsCbMSFFQShxUdl8pZc-31kqnd6O3vK4Xte8SUxty9JdRRs9diySzXW0AKXObdYTreh5-vs&vault=true&intent=subscription';
      s.onload = () => window.paypal.Buttons({
        style: { shape: 'rect', color: 'gold', layout: 'vertical', label: 'subscribe' },
        createSubscription: (data, actions) => actions.subscription.create({ plan_id: plan }),
        onApprove: (data) => alert('Danke! Abo-ID: ' + data.subscriptionID),
      }).render('#paypal-subscribe');
      document.head.appendChild(s);
    });
  </script>
</Base>
