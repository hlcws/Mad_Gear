---
// Layout only. All wording lives in src/content/start/*.md
import Base from '../layouts/Base.astro';
import HeroLogo from '../components/HeroLogo.astro';
import Media from '../components/Media.astro';
import Prices from '../components/Prices.astro';
import SectionHead from '../components/SectionHead.astro';
import LiveUpdater from '../components/LiveUpdater.astro';
import { site } from '../site.config.mjs';
import { loadFeed } from '../lib/feed.js';
import { inline } from '../lib/inline.js';
import { renderStatus, renderEvents, statusKind } from '../lib/render.js';

import * as hero from '../content/start/1-hero.md';
import * as locals from '../content/start/2-was-ist-ein-local.md';
import * as sessions from '../content/start/3-sessions.md';
import * as streams from '../content/start/4-streams.md';
import * as clubhaus from '../content/start/5-clubhaus.md';
import * as anfahrt from '../content/start/6-anfahrt.md';
import * as kontakt from '../content/start/7-kontakt.md';
import * as preise from '../content/preise.md';

const feed = loadFeed();
---
<Base>
  <section class="hero">
    <div class="hero-bg" style="background-image:url('/photos/location1.jpg')"></div>
    <div class="wrap">
      <div>
        <span class="kanji" lang="ja">{site.kanji}{site.kanjiReading && <span class="reading" lang="en">[{site.kanjiReading}]</span>}</span>
        <h1><span class="club-name">{site.name}<span class="sr-only"> – </span></span><Fragment set:html={inline(hero.frontmatter.title)} /></h1>
        <div class="tagline md"><hero.Content /></div>
        <div class="status-card" data-live="status" data-kind={statusKind(feed)} aria-live="polite" set:html={renderStatus(feed)} />
      </div>
      <HeroLogo />
    </div>
  </section>

  <section id="was-ist-ein-local">
    <div class="wrap">
      <SectionHead fm={locals.frontmatter} />
      <div class="lead md"><locals.Content /></div>
      <div class="locals-grid">
        {locals.frontmatter.cards?.map((c) => (
          <div class="local-point">
            <h3>{c.title}</h3>
            <p set:html={inline(c.text)} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="termine">
    <div class="wrap">
      <SectionHead fm={sessions.frontmatter} />
      <div class="grid-2">
        <div data-live="events" data-limit="5" set:html={renderEvents(feed, { limit: 5 })} />
        <div>
          {sessions.frontmatter.callout && <div class="callout" set:html={inline(sessions.frontmatter.callout)} />}
          <div class="lead md"><sessions.Content /></div>
          <div class="btn-row" style="margin-top:18px">
            <a class="btn btn-discord" href={site.links.discord}>Discord beitreten</a>
            <a class="btn" href="/termine.html">Termine &amp; Kalender</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Media feed={feed} head={streams.frontmatter}><streams.Content /></Media>

  <section id="clubhaus">
    <div class="wrap grid-2">
      <div>
        <SectionHead fm={clubhaus.frontmatter} />
        <ul class="check-list">{clubhaus.frontmatter.equipment?.map((e) => <li>{e}</li>)}</ul>
        <div class="lead md" style="margin-top:16px"><clubhaus.Content /></div>
        <h3 style="font-size:1.4rem;margin:28px 0 12px">{clubhaus.frontmatter.games_title}</h3>
        <ul class="chips">{clubhaus.frontmatter.games?.map((g) => <li>{g}</li>)}</ul>
      </div>
      <div class="photos">
        <img src="/photos/location1.jpg" alt="Spielstationen im Clubhaus" loading="lazy" />
        <img src="/photos/location2.jpg" alt="Arcade Cabinets im Clubhaus" loading="lazy" />
      </div>
    </div>
  </section>

  <section id="preise">
    <div class="wrap">
      <SectionHead fm={preise.frontmatter} />
      <Prices />
      <div class="btn-row">
        <a class="btn btn-primary" href="/tickets.html">Tickets kaufen</a>
        <a class="btn" href={site.links.paypal}>Spenden via PayPal</a>
        <a class="btn" href={site.links.shop}>Merch-Shop</a>
      </div>
    </div>
  </section>

  <section id="anfahrt">
    <div class="wrap grid-2">
      <div>
        <SectionHead fm={anfahrt.frontmatter} />
        <p class="address">{site.address.street}<br />{site.address.city}<br /><small>{site.address.floor} · kein Aufzug</small></p>
        <div class="lead md"><anfahrt.Content /></div>
        <div class="btn-row" style="margin-top:18px">
          <a class="btn btn-primary" href="/anfahrt.html">Anfahrt & Details</a>
          <a class="btn" href="/regeln.html">Clubregeln lesen</a>
        </div>
      </div>
      <div>
        <SectionHead fm={kontakt.frontmatter} />
        <div class="lead md"><kontakt.Content /></div>
        <div class="btn-row" style="margin-top:18px">
          <a class="btn" href="/gang.html">Die Gang kennenlernen</a>
          <a class="btn" href={`mailto:${site.email}`}>E-Mail</a>
        </div>
      </div>
    </div>
  </section>

  <LiveUpdater feed={feed} />
</Base>
