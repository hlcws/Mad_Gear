---
// Layout only. All wording lives in src/content/start/*.md
import Base from '../layouts/Base.astro';
import HeroLogo from '../components/HeroLogo.astro';
import Media from '../components/Media.astro';
import Prices from '../components/Prices.astro';
import SectionHead from '../components/SectionHead.astro';
import LiveUpdater from '../components/LiveUpdater.astro';
import { site } from '../site.config.mjs';
import { loadFeed } from '../lib/feed.js';
import { inline } from '../lib/inline.js';
import { renderStatus, renderEvents, statusKind, displayTitle } from '../lib/render.js';
import { venueEvents } from '../lib/status.js';

import * as hero from '../content/start/1-hero.md';
import * as locals from '../content/start/2-was-ist-ein-local.md';
import * as sessions from '../content/start/3-sessions.md';
import * as streams from '../content/start/4-streams.md';
import * as clubhaus from '../content/start/5-clubhaus.md';
import * as anfahrt from '../content/start/6-anfahrt.md';
import * as kontakt from '../content/start/7-kontakt.md';
import * as preise from '../content/preise.md';

const feed = loadFeed();
// Games: plain names or { name, tier }. Bigger tiers (1) first, bubble size by tier.
const games = (clubhaus.frontmatter.games ?? [])
  .map((g) => (typeof g === 'string' ? { name: g, tier: 3 } : { tier: 3, ...g }))
  .sort((a, b) => a.tier - b.tier);

// Structured data for search engines: the club, and the next sessions as events.
const [postalCode, ...locality] = site.address.city.split(' ');
const place = {
  '@type': 'Place',
  name: site.name,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode,
    addressLocality: locality.join(' '),
    addressCountry: 'DE',
  },
  // Centre of the map embed on the Anfahrt page.
  geo: { '@type': 'GeoCoordinates', latitude: 49.98335, longitude: 8.5795 },
};
const image = `${site.url}/photos/club1.jpg`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    ...place,
    '@type': 'SportsClub',
    url: site.url,
    image,
    logo: `${site.url}/logo-full-ffm.svg`,
    description: hero.frontmatter.description,
    email: site.email,
    sameAs: [site.links.discord, site.links.twitch, site.links.youtube, site.links.twitter],
  },
  ...venueEvents(feed).filter((e) => new Date(e.end) > new Date()).slice(0, 6).map((e) => ({
    '@context': 'https://schema.org',
    '@type': 'Event',
    name: `${site.name}: ${displayTitle(e)}`,
    startDate: e.start,
    endDate: e.end,
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    eventStatus: 'https://schema.org/EventScheduled',
    location: place,
    image,
    organizer: { '@type': 'Organization', name: site.name, url: site.url },
  })),
];
---
<Base description={hero.frontmatter.description} jsonLd={jsonLd}>
  <section class="hero">
    <div class="hero-bg" style="background-image:url('/photos/location1.jpg')"></div>
    <div class="wrap">
      <div>
        <span class="kanji" lang="ja">{site.kanji}{site.kanjiReading && <span class="reading" lang="en">[{site.kanjiReading}]</span>}</span>
        <h1><span class="club-name">{site.name}<span class="sr-only"> – </span></span><Fragment set:html={inline(hero.frontmatter.title)} /></h1>
        <div class="tagline md"><hero.Content /></div>
        <div class="status-card" data-live="status" data-kind={statusKind(feed)} aria-live="polite" set:html={renderStatus(feed)} />
      </div>
      <HeroLogo />
    </div>
  </section>

  <section id="termine">
    <div class="wrap">
      <SectionHead fm={sessions.frontmatter} />
      <div class="events-2col" data-live="events" data-limit="6" set:html={renderEvents(feed, { limit: 6 })} />
      <div class="sessions-info">
        {sessions.frontmatter.callout && <div class="callout" set:html={inline(sessions.frontmatter.callout)} />}
        <div class="lead md"><sessions.Content /></div>
        <div class="btn-row" style="margin-top:18px">
          <a class="btn btn-discord" href={site.links.discord}>Discord beitreten</a>
          <a class="btn" href="/termine.html">Termine &amp; Kalender</a>
        </div>
      </div>
    </div>
  </section>

  <section id="was-ist-ein-local">
    <div class="wrap">
      <SectionHead fm={locals.frontmatter} />
      <div class="lead md"><locals.Content /></div>
      <div class="locals-grid">
        {locals.frontmatter.cards?.map((c) => (
          <div class="local-point">
            <h3>{c.title}</h3>
            <p set:html={inline(c.text)} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <Media feed={feed} head={streams.frontmatter}><streams.Content /></Media>

  <section id="clubhaus">
    <div class="wrap grid-2">
      <div>
        <SectionHead fm={clubhaus.frontmatter} />
        <ul class="check-list">{clubhaus.frontmatter.equipment?.map((e) => <li>{e}</li>)}</ul>
        <div class="lead md" style="margin-top:16px"><clubhaus.Content /></div>
        <h3 style="font-size:1.4rem;margin:28px 0 12px">{clubhaus.frontmatter.games_title}</h3>
        <ul class="chips games">{games.map((g) => <li class={`tier-${g.tier}`}>{g.name}</li>)}</ul>
      </div>
      <div class="photos">
        <img class="wide" src="/photos/club1.jpg" width="1600" height="1200" alt="Der Club mit Arcade Cabinets und Spielstationen" loading="lazy" />
        <img src="/photos/club2.jpg" width="1200" height="1600" alt="Halloween-Session an den King of Fighters XI Cabinets" loading="lazy" style="object-position:center 20%" />
        <img src="/photos/club3.jpg" width="1600" height="1200" alt="Casuals an den Screens" loading="lazy" />
      </div>
    </div>
  </section>

  <section id="anfahrt">
    <div class="wrap grid-2">
      <div>
        <SectionHead fm={anfahrt.frontmatter} />
        <p class="address">{site.address.street}<br />{site.address.city}<br /><small>{site.address.floor} · kein Aufzug</small></p>
        <div class="lead md"><anfahrt.Content /></div>
        <div class="btn-row" style="margin-top:18px">
          <a class="btn btn-primary" href="/anfahrt.html">Anfahrt & Details</a>
          <a class="btn" href="/regeln.html">Clubregeln lesen</a>
        </div>
      </div>
      <div>
        <SectionHead fm={kontakt.frontmatter} />
        <div class="lead md"><kontakt.Content /></div>
        <div class="btn-row" style="margin-top:18px">
          <a class="btn" href="/gang.html">Die Gang kennenlernen</a>
          <a class="btn" href={`mailto:${site.email}`}>E-Mail</a>
        </div>
      </div>
    </div>
  </section>

  <section id="preise">
    <div class="wrap">
      <SectionHead fm={preise.frontmatter} />
      <Prices donations={false} />
      <div class="btn-row">
        <a class="btn btn-primary" href="/tickets.html">Tickets kaufen</a>
      </div>
    </div>
  </section>

  <LiveUpdater feed={feed} />
</Base>
